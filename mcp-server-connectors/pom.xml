<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.casehub</groupId>
        <artifactId>casehub-connectors-parent</artifactId>
        <version>0.4-SNAPSHOT</version>
    </parent>
    <artifactId>casehub-mcp-server-connectors</artifactId>
    <name>CaseHub MCP Server :: Connectors</name>
    <description>Standalone MCP server exposing connectors' 130+ tools.
        Run from target/quarkus-app/: java -jar quarkus-run.jar</description>

    <dependencies>
        <!-- Platform MCP runtime -->
        <dependency>
            <groupId>io.casehub</groupId>
            <artifactId>casehub-platform-mcp-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.casehub</groupId>
            <artifactId>casehub-platform-mcp</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>io.quarkiverse.mcp</groupId>
                    <artifactId>quarkus-mcp-server-sse</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Connectors domain APIs (all @McpDomain classes) -->
        <dependency>
            <groupId>io.casehub</groupId>
            <artifactId>casehub-connectors-graphql</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Connector core -->
        <dependency>
            <groupId>io.casehub</groupId>
            <artifactId>casehub-connectors-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.casehub</groupId>
            <artifactId>casehub-connectors-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.casehub</groupId>
            <artifactId>casehub-connectors-notification-bridge</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Email connector (required by ConnectorService wiring) -->
        <dependency>
            <groupId>io.casehub</groupId>
            <artifactId>casehub-connectors-email</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- All 13 ref implementations (zero-config defaults) -->
        <dependency><groupId>io.casehub</groupId><artifactId>casehub-connectors-chat-ref</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.casehub</groupId><artifactId>casehub-connectors-calendar-ref</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.casehub</groupId><artifactId>casehub-connectors-bank-ref</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.casehub</groupId><artifactId>casehub-connectors-email-ref</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.casehub</groupId><artifactId>casehub-connectors-document-ref</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.casehub</groupId><artifactId>casehub-connectors-contacts-ref</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.casehub</groupId><artifactId>casehub-connectors-project-ref</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.casehub</groupId><artifactId>casehub-connectors-location-ref</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.casehub</groupId><artifactId>casehub-connectors-commerce-ref</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.casehub</groupId><artifactId>casehub-connectors-travel-ref</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.casehub</groupId><artifactId>casehub-connectors-health-ref</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.casehub</groupId><artifactId>casehub-connectors-voice-ref</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.casehub</groupId><artifactId>casehub-connectors-voice-sherpa</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.casehub</groupId><artifactId>casehub-connectors-mobile-ref</artifactId><version>${project.version}</version></dependency>

        <!-- Platform core (NoOpDeliveryChannelRegistry, MockCurrentPrincipal) -->
        <dependency>
            <groupId>io.casehub</groupId>
            <artifactId>casehub-platform-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Quarkus runtime -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-security</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-seed-corpus</id>
                        <phase>package</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/quarkus-app/corpus</outputDirectory>
                            <resources>
                                <resource><directory>${project.basedir}/../bank-ref/src/test/resources/seed/bank</directory><targetPath>bank</targetPath></resource>
                                <resource><directory>${project.basedir}/../calendar-ref/src/test/resources/seed/calendar</directory><targetPath>calendar</targetPath></resource>
                                <resource><directory>${project.basedir}/../chat-ref/src/test/resources/seed/chat</directory><targetPath>chat</targetPath></resource>
                                <resource><directory>${project.basedir}/../commerce-ref/src/test/resources/seed/commerce</directory><targetPath>commerce</targetPath></resource>
                                <resource><directory>${project.basedir}/../contacts-ref/src/test/resources/seed/contacts</directory><targetPath>contacts</targetPath></resource>
                                <resource><directory>${project.basedir}/../document-ref/src/test/resources/seed/document</directory><targetPath>document</targetPath></resource>
                                <resource><directory>${project.basedir}/../email-ref/src/test/resources/seed/email</directory><targetPath>email</targetPath></resource>
                                <resource><directory>${project.basedir}/../health-ref/src/test/resources/seed/health</directory><targetPath>health</targetPath></resource>
                                <resource><directory>${project.basedir}/../location-ref/src/test/resources/seed/location</directory><targetPath>location</targetPath></resource>
                                <resource><directory>${project.basedir}/../mobile-ref/src/test/resources/seed/mobile</directory><targetPath>mobile</targetPath></resource>
                                <resource><directory>${project.basedir}/../project-ref/src/test/resources/seed/project</directory><targetPath>project</targetPath></resource>
                                <resource><directory>${project.basedir}/../travel-ref/src/test/resources/seed/travel</directory><targetPath>travel</targetPath></resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>native</id>
            <activation>
                <property><name>native</name></property>
            </activation>
            <properties>
                <quarkus.native.enabled>true</quarkus.native.enabled>
                <quarkus.native.resources.includes>corpus/**/*.yaml</quarkus.native.resources.includes>
            </properties>
        </profile>
        <profile>
            <id>stdio</id>
            <activation>
                <property><name>!http</name></property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.quarkiverse.mcp</groupId>
                    <artifactId>quarkus-mcp-server-stdio</artifactId>
                    <version>${quarkus-mcp-server.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>http</id>
            <activation>
                <property><name>http</name></property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.quarkiverse.mcp</groupId>
                    <artifactId>quarkus-mcp-server-sse</artifactId>
                    <version>${quarkus-mcp-server.version}</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
